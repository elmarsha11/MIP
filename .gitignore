# ---------------------------------------------------------------------------
# Derivados regenerables
# ---------------------------------------------------------------------------
# Cache de consultas a buscadores y registros. Se regenera solo; la evidencia
# que importa vive en titulo_fragmento dentro de la base, no aca.
data/processed/discovery/cache/

# Cache de respuestas de Gemini y contador de cuota diaria. Es estado local de
# la maquina que corre el motor, no conocimiento del proyecto.
data/processed/extraction/cache/

# Respuestas crudas de Overpass. Se regeneran solas; lo que importa queda
# normalizado en entidades_86.sqlite con su URL de origen.
data/processed/territorio/cache/

# Texto de las paginas guardado para no re-crawlear en cada iteracion del motor
# comercial. Es una copia de portales publicos: se regenera sola y no es la
# evidencia (esa vive con su cita en oportunidades_86.sqlite).
data/processed/oportunidades/cache/

# Texto de los boletines oficiales bajados de SIBOM. Son PDFs publicos de 700 KB
# cada uno y se regeneran solos; la evidencia queda con su cita y su URL en
# gabinete_86.sqlite.
data/processed/gabinete/cache/

# URLs de medios ya resueltas. Se regenera solo y solo guarda aciertos: un
# medio que no resolvio se reintenta en la corrida siguiente.
data/processed/medios/cache/

# El CSV del SNIC: 67 MB de estadistica criminal por departamento. Se cachea
# porque la serie de un anio cerrado no cambia, pero NO se versiona: a
# diferencia de los cuadros de INDEC (360 KB), pesa demasiado para el valor que
# agrega estar adentro del repositorio. Se vuelve a bajar con --refrescar.
data/processed/seguridad/cache/

# EXCEPCION deliberada: data/processed/indec/cache/ SI se versiona.
# Los otros caches guardan respuestas de servicios vivos que cambian y se vuelven
# a pedir. Estos son los cuadros del Censo 2022, resultados DEFINITIVOS: no van a
# cambiar nunca. Son 360 KB y tenerlos adentro hace que la poblacion y la
# apertura por sexo de los 86 sigan siendo reproducibles aunque INDEC reorganice
# su FTP. Es la fuente, no una copia temporal.

src/tablero/web/_prueba.html
progreso_municipios.json

